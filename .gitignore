# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshots (local proof artifacts)
/screenshots

# placeholder images stay local — real assets served from storage later
# public/images/*.jpg uncommit if you want placeholders in repo
assets/Procreate-batch/
.claude/

# one-off diagnostic scripts hardcoded to specific incident IDs — not reusable
scripts/check-canary-state.ts
scripts/check-gelato-product-detail.ts
scripts/check-variant-connection-status.ts
scripts/compare-stuck-variants.ts
scripts/gelato-err-detail.ts
